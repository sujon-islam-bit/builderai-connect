# BuilderAI Connect — environment variables (placeholders only, never real secrets here)

# This service's own database (separate from BuilderAI's database).
DATABASE_URL="postgresql://user:password@localhost:5434/builderai_connect"

# This service's OWN Google OAuth client (its own Google Cloud client;
# its redirect URI is <NEXT_PUBLIC_APP_URL>/oauth/callback).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Shared key BuilderAI must send as the `x-connect-key` header to call /api/proxy.
CONNECT_API_KEY=""

# Key used to encrypt stored OAuth tokens (AES-256-GCM, derived via SHA-256).
CONNECT_ENCRYPTION_KEY=""

# Public base URL of this service (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# Owner login for the dashboard — the only account that can open / and
# /connections. When these are unset the dashboard stays locked.
# OWNER_PASSWORD_HASH is a bcrypt hash, never the plain password.
# Generate one (already $-escaped) with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 12).replace(/\$/g, '\\$'))"
# The \$ escaping matters: Next.js expands $... sequences in .env values,
# which silently corrupts a raw bcrypt hash (every $ in it) and the
# correct password then never matches.
OWNER_EMAIL=""
OWNER_PASSWORD_HASH=""

# Signs the owner session cookie (HMAC-SHA256). Falls back to
# CONNECT_ENCRYPTION_KEY when unset.
SESSION_SECRET=""
